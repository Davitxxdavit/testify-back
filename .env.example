# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cafeteria_burger?schema=public

# JWT (at least 32 characters each)
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=change-me-to-another-random-string-of-32-or-more
JWT_REFRESH_EXPIRES_IN=7d

# Redis (REDIS_URL takes precedence when set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://localhost:6379

# First admin account, created on startup when no admin exists.
# Required in production; in development it defaults to 555000001 / admin123.
ADMIN_PHONE=
ADMIN_PASSWORD=

# Uploads and rate limiting
UPLOAD_DEST=./uploads
MAX_FILE_SIZE=5242880
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Payment and delivery providers (placeholder integrations)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
GLOVO_API_KEY=
GLOVO_API_SECRET=
GLOVO_WEBHOOK_SECRET=

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
