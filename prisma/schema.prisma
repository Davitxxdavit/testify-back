// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  KITCHEN
  COURIER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum OrderType {
  INSTANT
  SCHEDULED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryType {
  OWN
  GLOVO
  PICKUP
}

enum DeliveryTaskStatus {
  ASSIGNED
  PICKING_UP
  DELIVERING
  DONE
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentProvider {
  STRIPE
  ADYEN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  name          String
  passwordHash  String    @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  addresses     Address[]
  orders        Order[]
  chats         Chat[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Staff {
  id           String   @id @default(uuid())
  name         String
  role         UserRole
  phone        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  chats         Chat[]
  deliveryTasks DeliveryTask[]

  @@index([role])
  @@index([phone])
  @@map("staff")
}

model Address {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  street      String
  city        String
  postalCode  String?  @map("postal_code")
  country     String   @default("Georgia")
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model MenuCategory {
  id        Int      @id @default(autoincrement())
  name      String
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  items MenuItem[]

  @@index([sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category   MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifiers  MenuModifier[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("menu_items")
}

model MenuModifier {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  name      String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  item              MenuItem            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@index([itemId])
  @@map("menu_modifiers")
}

model Order {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  status        OrderStatus   @default(PENDING)
  type          OrderType
  scheduledFor  DateTime?     @map("scheduled_for")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  deliveryType  DeliveryType  @map("delivery_type")
  totalPrice    Decimal       @db.Decimal(10, 2) @map("total_price")
  addressId     String?       @map("address_id")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  contactPhone  String?       @map("contact_phone")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  address         Address?            @relation(fields: [addressId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  chats           Chat[]
  glovoOrder      GlovoOrder?
  deliveryTask    DeliveryTask?
  statusHistory   OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([scheduledFor])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at")
  changedBy String?     @map("changed_by")
  notes     String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([changedAt])
  @@map("order_status_history")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId  String   @map("order_id")
  itemId   Int      @map("item_id")
  quantity Int
  price    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      MenuItem           @relation(fields: [itemId], references: [id])
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([itemId])
  @@map("order_items")
}

model OrderItemModifier {
  id           String   @id @default(uuid())
  orderItemId  String   @map("order_item_id")
  modifierId   Int      @map("modifier_id")
  price        Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  orderItem OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  MenuModifier @relation(fields: [modifierId], references: [id])

  @@index([orderItemId])
  @@index([modifierId])
  @@map("order_item_modifiers")
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String          @map("order_id")
  provider          PaymentProvider
  providerPaymentId String?         @map("provider_payment_id")
  amount            Decimal         @db.Decimal(10, 2)
  status            PaymentStatus
  idempotencyKey    String?         @unique @map("idempotency_key")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([idempotencyKey])
  @@map("payments")
}

model Chat {
  id        String    @id @default(uuid())
  orderId   String    @map("order_id")
  userId    String?   @map("user_id")
  staffId   String?   @map("staff_id")
  message   String
  sentAt    DateTime  @default(now()) @map("sent_at")

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([sentAt])
  @@index([orderId, sentAt])
  @@map("chats")
}

model GlovoOrder {
  id            String      @id @default(uuid())
  orderId       String      @unique @map("order_id")
  glovoOrderId  String      @map("glovo_order_id")
  status        String
  trackingUrl   String?     @map("tracking_url")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([glovoOrderId])
  @@index([orderId])
  @@map("glovo_orders")
}

model DeliveryTask {
  id        String            @id @default(uuid())
  orderId   String            @unique @map("order_id")
  courierId String?           @map("courier_id")
  status    DeliveryTaskStatus @default(ASSIGNED)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier  Staff?  @relation(fields: [courierId], references: [id], onDelete: SetNull)

  @@index([courierId])
  @@index([status])
  @@index([orderId])
  @@map("delivery_tasks")
}

